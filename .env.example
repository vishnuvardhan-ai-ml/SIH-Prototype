# Environment Configuration for SIH-Prototype Backend
PROJECT_NAME="SIH Risk Prediction API"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL="sqlite:///./backend/app/database/sih_prototype.db"

# Model Artifacts Path
MODEL_ARTIFACTS_DIR="ml/models"
